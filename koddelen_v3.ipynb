   # Annualize monthly returns
factors_q1 = factors.copy()
stocks_q1 = stocks.copy()

factors_q1[['rm_rf','smb_vw','hml_vw','rf']] *= 12
stocks_q1.iloc[:,3:] *= 12

# Plot all three factors together
plt.figure(figsize=(10,6))
plt.plot(factors_q1['rm_rf'], label='Market Excess Return')
plt.plot(factors_q1['smb_vw'], label='SMB')
plt.plot(factors_q1['hml_vw'], label='HML')
plt.legend()
plt.title("Fama-French Factors (Annualized)")
plt.show()

# Plot each factor separately
plt.figure(figsize=(10,4))
plt.plot(factors_q1['rm_rf'], label='Market Excess Return')
plt.legend()
plt.title("Market Excess Return (Annualized)")
plt.show()

plt.figure(figsize=(10,4))
plt.plot(factors_q1['smb_vw'], label='SMB')
plt.legend()
plt.title("SMB (Annualized)")
plt.show()

plt.figure(figsize=(10,4))
plt.plot(factors_q1['hml_vw'], label='HML')
plt.legend()
plt.title("HML (Annualized)")
plt.show()

# Plot risk-free rate
plt.figure(figsize=(10,4))
plt.plot(factors_q1['rf'], label='Risk Free Rate')
plt.legend()
plt.title("Risk Free Rate (Annualized)")
plt.show()

# Report averages
print("Average factor returns:")
print(factors_q1[['rm_rf','smb_vw','hml_vw']].mean().round(4))

# Covariance matrix for the three factors
print("\nVariance-Covariance matrix (3x3):")
cov3 = factors_q1[['rm_rf','smb_vw','hml_vw']].cov()
display(cov3.style.format("{:.4f}").background_gradient(cmap="YlGnBu"))

# Covariance matrix including risk-free rate
print("\nVariance-Covariance matrix (4x4, including rf):")
cov4 = factors_q1[['rm_rf','smb_vw','hml_vw','rf']].cov()
display(cov4.style.format("{:.4f}").background_gradient(cmap="YlOrRd"))

# Report average risk-free rate
print("\nAverage Risk Free Rate:")
print(round(factors_q1['rf'].mean(), 4))
